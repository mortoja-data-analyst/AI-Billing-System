        "# Project 1: Mobile-Friendly AI Billing System\n",
        "!pip install gTTS -q\n",
        "from gtts import gTTS\n",
        "import IPython.display as ipd\n",
        "\n",
        "# 💡 No Enter key needed! Python will read this automatically.\n",
        "# 💡 You can easily change these names inside the quotes whenever you want.\n",
        "customer_name = \"Mortoja Sardar\"\n",
        "product_name = \"Smart Watch\"\n",
        "original_price = 4000.0\n",
        "discount_percent = 10.0\n",
        "\n",
        "# Backend processing and calculations\n",
        "discount_amount = original_price * (discount_percent / 100)\n",
        "final_bill = original_price - discount_amount\n",
        "\n",
        "# Printing Professional Digital Invoice layout\n",
        "print(\"\\n\" + \"=\"*35)\n",
        "print(\"        ** DIGITAL INVOICE **       \")\n",
        "print(\"=\"*35)\n",
        "print(\"Customer Name  :\", customer_name)\n",
        "print(\"Product Name   :\", product_name)\n",
        "print(\"Original Price : \" + str(original_price) + \" RS\")\n",
        "print(\"Discount (-)   : \" + str(discount_amount) + \" RS (\" + str(discount_percent) + \"%)\")\n",
        "print(\"-\"*35)\n",
        "print(\"Total Bill     : \" + str(final_bill) + \" RS\")\n",
        "print(\"=\"*35)\n",
        "print(\"    Thank you for shopping with us!    \")\n",
        "print(\"=\"*35 + \"\\n\")\n",
        "\n",
        "# Generating AI Voice Confirmation (Computer speaks in English)\n",
        "voice_text = f\"Hello {customer_name}! Thank you for your purchase. Your final bill is {final_bill} rupees.\"\n",
        "tts = gTTS(voice_text)\n",
        "tts.save(\"invoice_voice.mp3\")\n",
        "\n",
        "# Displaying Audio Player on Screen\n",
        "print(\"↓ Click below to hear the voice confirmation ↓\")\n",
        "ipd.Audio(\"invoice_voice.mp3\")"
      ]
    }
